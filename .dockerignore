# Build context excludes for services/Dockerfile (context = repo root).
# Keeps the image small and keeps secrets / local junk out of the build.

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Python / virtualenv ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Not needed by the ingestion image ----
# NOTE: do NOT add `gateway/` here. The Gateway's Nixpacks build runs from the
# repo root and also honours this .dockerignore, so excluding gateway/ strips the
# gateway package out of its own image and uvicorn dies with
# "ModuleNotFoundError: No module named 'gateway'". The ingestion Dockerfile only
# COPYs services/ and shared/, so keeping gateway/ in the context costs the
# ingestion image nothing (it's never COPYed into it).
frontend/
tests/
infra/
deploy/
data/
.git/
.github/

# ---- Dagster local instance / data artifacts ----
.tmp_dagster_home_*/
tmp_dagster_home_*/
dagster_home/
*.dagster/
*.parquet
*.duckdb
