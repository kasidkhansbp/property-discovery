{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "bash services/scripts/migrate.sh",
    "cronSchedule": "0 6 24 * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
